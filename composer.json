{
    "name": "michaelkaefer/table-bundle",
    "description": "Bundle to use michaelkaefer/table in Symfony apps",
    "license": "MIT",
    "type": "symfony-bundle",
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Project Contributors",
            "homepage": "https://github.com/michaelKaefer/TableBundle/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "michaelkaefer/table": "^0.1",
        "symfony/framework-bundle": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "MichaelKaefer\\TableBundle\\": "src"
        }
    },
    "extra": {
        "branch-alias": {
            "0.x-dev": "0.1.x-dev"
        }
    }
}
